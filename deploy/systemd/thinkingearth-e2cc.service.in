[Unit]
Description=ThinkingEarth E2CC WebRTC stream
Wants=network-online.target
After=network-online.target
PartOf=thinkingearth-streaming.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=@CONFIG_FILE@
WorkingDirectory=@PROJECT_DIR@
ExecStartPre=@PROJECT_DIR@/scripts/run_e2cc_streaming.sh --check-only
ExecStart=@PROJECT_DIR@/scripts/run_e2cc_streaming.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=thinkingearth-streaming.target
