# Copy this file to streaming.env and replace the machine-specific values.
# Keep assignments compatible with both Bash and systemd EnvironmentFile syntax.

E2CC_APP_DIR=/path/to/earth2-weather-analytics/earth-2-command-center
E2CC_PUBLIC_IP=192.0.2.10
E2CC_SIGNAL_PORT=49100
E2CC_MEDIA_PORT=47998
E2CC_HTTP_PORT=8011

E2CC_STREAM_URL=http://192.0.2.10:8011
E2CC_STREAM_HTTP_PORT=8011
E2CC_STREAM_SIGNAL_PORT=49100
E2CC_STREAM_MEDIA_PORT=47998

FLASK_BIND=0.0.0.0:5000
FLASK_WORKERS=2
FLASK_APP_MODULE=app:app
