{
    "name": "PROTOTYPE Dev Container",
    "image": "thinkingearth_prototype-dev:${localEnv:USER}",
    "initializeCommand": "bash .devcontainer/start.sh --build-only",
    "runArgs": [
        "--gpus=${localEnv:DEV_CONTAINER_GPUS:all}",
        "--ipc=host",
        "--ulimit=memlock=-1",
        "--ulimit=stack=67108864",
        "--env-file=${localWorkspaceFolder}/scripts/env.env"
    ],
    "workspaceFolder": "/thinkingearth_prototype",
    "workspaceMount": "source=${localWorkspaceFolder},target=/thinkingearth_prototype,type=bind",
    "containerEnv": {
        "WANDB_MODE": "online"
    },
    "mounts": [
        "source=${localEnv:DEV_CONTAINER_DATA_DIR:/var/tmp/data},target=/data,type=bind",
        "source=${localEnv:DEV_CONTAINER_OUTPUT_DIR:/var/tmp/thinkingearth_prototype},target=/workspace,type=bind"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-azuretools.vscode-docker",
                "ms-python.python",
                "ms-toolsai.jupyter",
                "tamasfe.even-better-toml"
            ]
        }
    }
}